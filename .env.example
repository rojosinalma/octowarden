# octowarden bootstrap configuration. Everything else lives in the settings table (Settings page / API).
# Copy to .env (mode 0600) and fill in. Values below are placeholders.

# optional — HTTP port (default 3000)
PORT=3000

# optional — directory for the SQLite database and the octoforge adoption file (default ./data)
DATA_DIR=./data

# optional — sqlite:<path> or postgres://user:password@host:5432/db (default sqlite:<DATA_DIR>/octowarden.db)
DATABASE_URL=sqlite:./data/octowarden.db

# optional — Postgres schema that holds every table (default octowarden; ignored for SQLite)
DATABASE_SCHEMA=octowarden

# optional — Postgres connection pool size (default 5)
DATABASE_POOL_MAX=5

# required for /api and /mcp — bearer token clients send; while unset those routes answer 503
API_TOKEN=change-me-long-random-string

# optional — GitHub personal access token; a token set in Settings wins over this one
GITHUB_TOKEN=

# optional — GitHub App credentials (all three together); values set in Settings win
GITHUB_APP_ID=
# PEM with literal \n for newlines
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# optional — secret for webhooks that octowarden creates in repos
GITHUB_WEBHOOK_SECRET=

# optional — enables /api/octoforge/* (octoforge member contract v1); unset = those routes answer 404
OCTOFORGE_TOKEN=

# optional — debug | info | warn | error (default info); the log_level setting wins once the database is up
LOG_LEVEL=info
